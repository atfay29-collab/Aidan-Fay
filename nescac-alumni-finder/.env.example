# Copy to .env (never commit .env) and fill in.

# --- People Data Labs (finds the alumni) ---
PDL_API_KEY=

# --- Hunter.io (finds work emails) ---
HUNTER_API_KEY=

# --- Google Sheets ---
# "service_account" (recommended for scripts) or "oauth" (your own Google account)
GOOGLE_AUTH_MODE=service_account
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
GOOGLE_OAUTH_CLIENT_FILE=credentials/oauth_client.json
GOOGLE_OAUTH_TOKEN_FILE=credentials/authorized_user.json
# The long ID in https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
# Required for service accounts. With oauth, leave blank to create a new sheet.
SPREADSHEET_ID=
SPREADSHEET_TITLE=NESCAC Alumni in Investment Banking

# --- Tuning (defaults are fine) ---
CACHE_PATH=.cache/alumni_finder.sqlite3
CACHE_TTL_DAYS=30
PDL_MIN_SECONDS_BETWEEN_CALLS=6.5
HUNTER_MIN_SECONDS_BETWEEN_CALLS=0.25
